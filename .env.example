# Twitch
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Alert tuning (optional — these are the defaults)
SPIKE_THRESHOLD=8
SPIKE_Z=3.0
MIN_RATE=5
COOLDOWN_MIN=5

# 通知対象の絞り込み（任意・カンマ区切りのチャンネルlogin）
# 設定するとそのチャンネルだけを監視・通知する。未設定ならフォロー中の全ライブ配信が対象。
# 例: NOTIFY_CHANNELS=shroud,k4sen,kato_junichi0817
NOTIFY_CHANNELS=

# Server
PORT=3000
DASHBOARD_PASSWORD=
