# Twitch
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Alert tuning (optional — these are the defaults)
SPIKE_THRESHOLD=8
SPIKE_Z=3.0
MIN_RATE=5
COOLDOWN_MIN=5

# 通知対象の絞り込み（任意・カンマ区切りのチャンネルlogin）
# 設定するとそのチャンネルだけを監視・通知する。未設定ならフォロー中の全ライブ配信が対象。
# 例: NOTIFY_CHANNELS=shroud,k4sen,kato_junichi0817
NOTIFY_CHANNELS=

# Server
PORT=3000
DASHBOARD_PASSWORD=

# 振り返りレポート
# DATA_DIR: 振り返りDB(SQLite)の保存先。ローカルは既定の ./data でよい。Fly.io では Volume のパス（例 /data）。
DATA_DIR=./data
# PUBLIC_BASE_URL: Discord に送る振り返りリンクの基点。ローカルは未設定でよい（http://localhost:PORT を使う）。
# Fly.io では公開URL（例 https://<your-app-name>.fly.dev）を設定する。
PUBLIC_BASE_URL=

# （任意・開発用）npm run dev:report -- --notify の送信先。本番チャンネルにテスト投稿を混ぜたくないとき、
# 別チャンネルの Webhook をここに設定する。未設定なら DISCORD_WEBHOOK_URL にフォールバック。
DEV_DISCORD_WEBHOOK_URL=
