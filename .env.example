# ============================================================
# ① 自分で書く（必須）  — `make setup` で記入漏れを検査できる
# ============================================================

# Twitch アプリの ID とシークレット
#   https://dev.twitch.tv/console/apps › アプリを作成（OAuth リダイレクト URL: http://localhost:22377/callback）
#   › 「管理」› クライアントID / 「新しい秘密」（シークレットの表示は一度きり）
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# ============================================================
# ② `make auth`（npm run auth）が自動で書く — 空のままでよい
# ============================================================
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# ============================================================
# ③ 任意 — 空なら既定値で動く
# ============================================================

# 通知先の Discord Webhook URL。空なら通知（アラート・振り返り）はコンソールに出力する。
#   Discord のチャンネル設定 › 連携サービス › ウェブフック › 新しいウェブフック › URL をコピー
DISCORD_WEBHOOK_URL=

# 監視・通知するチャンネルを絞る（カンマ区切りの login）。空ならフォロー中の全ライブ配信。
# 例: NOTIFY_CHANNELS=shroud,k4sen,kato_junichi0817
NOTIFY_CHANNELS=

# ダッシュボードの Basic 認証（ユーザー名 admin）。公開環境（Fly.io 等）では設定推奨。
# `make up`（ローカル）では無効になる。ローカルでも認証を試すときだけ DEV_DASHBOARD_PASSWORD を書く。
DASHBOARD_PASSWORD=
DEV_DASHBOARD_PASSWORD=

# `make up` でダッシュボードを開くポート（既定 3000）。3000 が他で使われているときに変える。
HOST_PORT=

# npm start で直接動かすときのポート（既定 3000）。Docker（make up）では使わず HOST_PORT を使う。
PORT=3000

# 振り返りDB(SQLite)の保存先。ローカルは ./data のままでよい。
# Fly.io では fly.toml の [env] で /data（永続ボリューム）を指定済みなので、secrets には DATA_DIR を入れないこと。
DATA_DIR=./data

# Discord に送る振り返りリンクの基点。ローカルは空でよい（http://localhost:<ポート> になる）。
# Fly.io では公開URL（例 https://<your-app-name>.fly.dev）を設定する。
PUBLIC_BASE_URL=

# 検知の感度（既定値。通知が多すぎる/少なすぎるときだけ調整。README「アラート検知ロジック」参照）
SPIKE_THRESHOLD=8
SPIKE_Z=3.0
MIN_RATE=5
COOLDOWN_MIN=5

# （開発用）npm run dev:report -- --notify の送信先。空なら DISCORD_WEBHOOK_URL を使う。
DEV_DISCORD_WEBHOOK_URL=
